<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="16"
    android:versionName="1.6">
    <queries><package android:name="com.android.systemui" /></queries>
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="Fold8 Control Lab"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="Fold8 Control Lab v1.6: clock bubbles, shade seconds, and window gestures" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
        <meta-data android:name="xposedminversion" android:value="82" />

        <activity android:name="com.fold8.secondsclock.ControlLabActivity"
            android:exported="true" android:label="Fold8 Control Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.fold8.secondsclock.LabHubActivity"
            android:exported="false" android:label="Fold8 Control Center" />

        <provider android:name="com.fold8.secondsclock.ClockSettingsProvider"
            android:authorities="com.fold8.secondsclock.settings"
            android:exported="true"
            android:directBootAware="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
